APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
DEMO_MODE=true
AGENT_RELEASE_ID=local
APP_SECRET_KEY=CHANGE_ME_FOR_LOCAL_ONLY
SQLITE_URL=sqlite:///./data/app.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
CHROMA_PATH=./data/chroma
BM25_INDEX_PATH=./data/bm25
MODEL_DEVICE=auto
EMBEDDING_MODEL_PATH=./models/embedding/bge-m3
RERANKER_MODEL_PATH=./models/reranker/bge-reranker-v2-m3
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
EMBED_BATCH_SIZE=8
RERANK_BATCH_SIZE=8
EMBED_MAX_SEQ_LENGTH=1024
RERANK_MAX_LENGTH=512
RETRIEVAL_DENSE_K=12
RETRIEVAL_BM25_K=12
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_K=12
RETRIEVAL_CONTEXT_K=4
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
# Optional provider-specific prices; no default price is assumed.
# LLM_INPUT_COST_PER_MILLION=0.00
# LLM_OUTPUT_COST_PER_MILLION=0.00
LLM_COST_CURRENCY=USD
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SECONDS=90
MCP_BASE_URL=http://127.0.0.1:8001/mcp
MCP_SERVICE_SECRET=CHANGE_ME_INTERNAL_ONLY
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
JUDGE_ENABLED=false
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
TRACE_CONTENT_ENABLED=false

# Harness: single-worker local runtime; disabling it fails closed for Agent execution.
HARNESS_ENABLED=true
HARNESS_TRACE_ENABLED=true
MODEL_CONTEXT_WINDOW=16384
CONTEXT_RESERVED_OUTPUT_TOKENS=2048
CONTEXT_SAFETY_MARGIN_TOKENS=1024
CONTEXT_MAX_INPUT_TOKENS=12000
CONTEXT_COMPACT_THRESHOLD=0.85
CONTEXT_RECENT_MESSAGE_LIMIT=8
CONTEXT_TOOL_RESULT_MAX_CHARS=3000
CONTEXT_STRATEGY=L0+L1+L2
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_CONCURRENCY=8
MODEL_MAX_RETRIES=2
TOOL_READ_MAX_RETRIES=2
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_MAX_TOKEN_BUDGET=48000
MODEL_JSON_MODE=false
REPEATED_ACTION_LIMIT=3

# Long-term memory: feature available, automatic saving still requires individual consent.
MEMORY_ENABLED=true
MEMORY_OPT_IN_DEFAULT=false
MEMORY_TOP_K=5
MEMORY_CANDIDATE_K=15
MEMORY_TOKEN_BUDGET=600
MEMORY_COLLECTION_NAME=customer_memories_v1
MEMORY_MIN_SIMILARITY=0.25
MEMORY_RERANK_ENABLED=false
MEMORY_JOB_MODE=async
MEMORY_EXTRACTION_MODEL=
MEMORY_TRIGGER_ENABLED=true
MEMORY_BATCH_ENABLED=true
MEMORY_BATCH_MAX_ELIGIBLE_MESSAGES=3
MEMORY_BATCH_MAX_MESSAGES=6
MEMORY_BATCH_IDLE_SECONDS=120
MEMORY_BATCH_MAX_WAIT_SECONDS=300
MEMORY_BATCH_WORKER_POLL_SECONDS=5
MEMORY_EXTRACTION_MAX_CANDIDATES_PER_MESSAGE=3
MEMORY_EXTRACTION_MAX_CANDIDATES_PER_BATCH=12
